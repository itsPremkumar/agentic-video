# Always LF, in the repo and in the working tree — matches .editorconfig.
# (Files are already stored with LF in the index, so switching to this does not
# produce a renormalisation diff; it only stops Windows checkouts diverging.)
* text=auto eol=lf

# Binary — never touch, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.wav  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary

# Generated lockfiles — keep them out of diffs and blame.
package-lock.json linguist-generated=true -diff
