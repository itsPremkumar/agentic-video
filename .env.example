# Agentic Video configuration — all optional.
# Every plugin reports a clear FAILED result when a key it needs is missing.
# There is no silent fallback: if a provider is not configured, the plugin fails.

# ─── Stock images & video ────────────────────────────────────────────────────
# Pexels  — images + video      https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay — images + video      https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Openverse + Wikimedia need no key at all.

# ─── Voicebox (local TTS, vendored at vendor/voicebox) ───────────────────────
# Set these only if you run the Voicebox server somewhere non-default.
# The plugins fall back to sane defaults when they are unset.
#   base URL of the running server
VOICEBOX_URL=http://127.0.0.1:17493
#   interpreter that has the Voicebox deps installed (see vendor/voicebox/README.md)
# VOICEBOX_PYTHON=.venv-voicebox/Scripts/python.exe
#   directory containing the `speech` package
# VOICEBOX_BACKEND_DIR=vendor/voicebox
#   bind host / port used by `voice.voicebox_server --input action=start`
VOICEBOX_HOST=127.0.0.1
VOICEBOX_PORT=17493

# ─── AI generation (only for the paid/cloud plugins) ─────────────────────────
# video.generate (fal.ai text-to-video / image-to-video)
FAL_KEY=
# image.generate
# REPLICATE_API_TOKEN=

# ─── Vision verification (image.verify / video.verify plugins) ───────────────
# OpenAI GPT-4o / GPT-4V for AI-powered image/video content verification
# OPENAI_API_KEY=sk-...
#
# Ollama for local vision models (e.g. llava, llama3.2-vision)
# OLLAMA_URL=http://localhost:11434
#
# If neither is set, verification falls back to heuristic mode (file size,
# dimensions, entropy checks) which requires no API key but is less accurate.

# ─── Toolchain overrides ─────────────────────────────────────────────────────
# Only needed when auto-detection gets it wrong. The legacy VIDEOFORGE_* names
# still work.
#   ffmpeg / ffprobe
# FFMPEG_PATH=
# FFPROBE_PATH=
#   python interpreter used by the Python plugin bridge
# AGENTIC_VIDEO_PYTHON=python
#   Chromium used by image.create / motion.canvas / motion.remotion
# CHROME_PATH=
# AGENTIC_VIDEO_CHROME=
#   HTTP API port (default 8787)
# PORT=8787
